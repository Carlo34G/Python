# =============================================================================
# Health Companion — configuration
# Copy this file to `.env` and fill in the values. Never commit the real .env.
# =============================================================================

# ---- Telegram -----------------------------------------------------------------
# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Get yours by messaging @userinfobot. Leave blank to allow ANYONE (not advised).
TELEGRAM_ALLOWED_USER_IDS=

# ---- OpenRouter (AI consultant) ----------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models . Cheap+capable default below.
# Stronger options: anthropic/claude-sonnet-4, openai/gpt-4o, google/gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Firecrawl (web search / scraping to ground the advice) -------------------
# https://firecrawl.dev  — optional. If blank, the bot answers without web search.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ---- Nutritionix (calorie lookup — solves the "no good calorie service") ------
# https://developer.nutritionix.com  — free tier is generous. Optional.
# If blank, the bot falls back to OpenFoodFacts (free, no key, weaker for whole foods).
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# ---- Sparky Fitness integration (best-effort; local SQLite is the source of truth) ----
# The base URL you browse Sparky at, e.g. http://srv-02:3004  (NO trailing slash).
# Leave blank to run the bot fully standalone (local SQLite only).
SPARKY_BASE_URL=
# Login used to obtain a JWT (email login). Leave blank to skip Sparky sync.
SPARKY_EMAIL=
SPARKY_PASSWORD=
# Optional: an API key with health_data_write permission (from Sparky settings).
SPARKY_API_KEY=

# ---- Your profile (used for BMR/TDEE + calorie/protein targets) ----------------
# sex is required for an accurate BMR (Mifflin-St Jeor differs by sex).
# Set this correctly — the default is an assumption, not a fact about you.
USER_SEX=male            # male | female
USER_AGE=50              # you told me 45-54; 50 is the midpoint
USER_HEIGHT_CM=175       # 5 ft 9 in
USER_START_WEIGHT_KG=120
USER_GOAL_WEIGHT_KG=95
# Activity multiplier applied to BMR to estimate maintenance calories.
# 1.2 sedentary | 1.375 light (exercise 1-3x/wk) | 1.55 moderate | 1.725 very active
USER_ACTIVITY_FACTOR=1.35
# Daily calorie deficit target for weight loss (500 ~= 0.5 kg/week).
USER_DAILY_DEFICIT=700

# ---- Storage ------------------------------------------------------------------
# Path to the local SQLite database (created automatically).
DATABASE_PATH=./health_companion.db
