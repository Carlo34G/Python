# ---- Record Collection Database configuration ----
# Copy this file to `.env` and fill in your values.

# --- AI recognizer (OpenRouter, OpenAI-compatible) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any vision-capable model on OpenRouter. Good cheap defaults:
#   openai/gpt-4o-mini            (cheap, reliable)
#   google/gemini-2.0-flash-001  (very cheap, fast)
# More capable: anthropic/claude-3.5-sonnet, openai/gpt-4o
OPENROUTER_MODEL=openai/gpt-4o-mini
# Base URL (only change if you use a proxy/self-host).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional — used for OpenRouter's usage rankings (safe to leave blank).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Record Collection Database

# --- Discogs (free) ---
# Authenticate read-only database search in EITHER of two ways:
#
#   Option A — personal access token (simplest for a single user):
#     Create one at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
#
#   Option B — application Consumer Key + Secret (from your Discogs app):
#     Used automatically if DISCOGS_TOKEN is left blank.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
#
# Sent as the User-Agent to Discogs (required by their API).
DISCOGS_USER_AGENT=RecordCollectionDB/1.0

# --- Database ---
# SQLite file path (inside the container this is a mounted volume).
DATABASE_URL=sqlite:////data/records.db

# --- Google Sheets backup (optional) ---
# Leave GOOGLE_SHEETS_ENABLED=false to skip the backup entirely.
GOOGLE_SHEETS_ENABLED=false
# Path to a Google service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_FILE=/data/service_account.json
# The spreadsheet's ID (from its URL) — share the sheet with the
# service-account email as an Editor.
GOOGLE_SHEET_ID=
# Worksheet/tab name to write to.
GOOGLE_SHEET_WORKSHEET=Collection
